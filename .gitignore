# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Design source material — the raw exports, AI-generated originals, and
# camera-roll-named intermediates that the committed assets in public/ were
# derived from (e.g. helix-pattern.png came out of a grok-image-*.jpg).
# They are several MB, nothing imports them, and they kept landing loose in
# public/ where a `git add -A` would sweep them into the repo. Drop new ones
# here instead; only the exported asset belongs in public/.
design-sources/

# Belt-and-braces for sources that land straight in public/ anyway: these two
# shapes are never a real asset name. Deliberately NOT ignoring things like
# public/Blog.jpg — an ordinary name could plausibly be a real asset later,
# and silently ignoring one is worse than an occasional manual cleanup.
/public/grok-image-*
/public/[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f]-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*.*

# Scratch clones / vendored experiments kept inside the repo working tree.
# Untracked today, so Vercel never sees them — but they carry their own
# tsconfig and deps, and `next build` type-checks them, so a `git add -A`
# would commit them and break the production build (liquid-glass-react's
# example imports a `Github` icon lucide-react does not export).
liquid-glass-js/
liquid-glass-react/
liquid-logo/

# local scratch and large media - never deploy these
.tmp-*.html
sales-pilot.html
/showcase/
/public/WhatsApp*
C:Users*
