# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# Scratch clones / vendored experiments kept inside the repo working tree.
# Untracked today, so Vercel never sees them — but they carry their own
# tsconfig and deps, and `next build` type-checks them, so a `git add -A`
# would commit them and break the production build (liquid-glass-react's
# example imports a `Github` icon lucide-react does not export).
liquid-glass-js/
liquid-glass-react/
liquid-logo/
