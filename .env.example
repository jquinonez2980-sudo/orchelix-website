# Variable names used by the app, with placeholder values only.
# Copy the keys into .env.local (untracked) and in Vercel's project settings.
# Never commit a real key.

# Stripe secret key — server-side only, used by app/api/checkout/route.ts.
# Use sk_test_... until the shop is ready to charge real cards.
STRIPE_SECRET_KEY=sk_test_placeholder

# The site's public URL. Builds absolute image URLs for Stripe Checkout and the
# success/cancel redirect back to /shop. https://www.orchelix.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
